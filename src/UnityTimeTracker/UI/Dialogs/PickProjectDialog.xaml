<d:DarkWindow x:Class="UnityTimeTracker.UI.Dialogs.PickProjectDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="clr-namespace:UnityTimeTracker.UI.Dialogs"
              xmlns:c="clr-namespace:UnityTimeTracker.UI.Controls">
  <StackPanel Margin="16" Width="380">
    <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="17"/>
    <Border Background="#2A2A2A" BorderBrush="#1F1F1F" BorderThickness="1" Height="220">
      <ListBox x:Name="Projects" MouseDoubleClick="OnDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Height="24">
              <c:ProjectIcon Source="{Binding}" Width="18" Height="18" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
      <Button x:Name="OkButton" IsDefault="True" MinWidth="80" Margin="8,0,0,0" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</d:DarkWindow>
