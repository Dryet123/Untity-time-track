<d:DarkWindow x:Class="UnityTimeTracker.UI.Dialogs.InstallDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="clr-namespace:UnityTimeTracker.UI.Dialogs"
              Title="Unity Time Tracker" Icon="/Assets/app.ico" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20" Width="440">
    <TextBlock x:Name="Heading" FontSize="18" Foreground="#E2E2E2" Margin="0,0,0,10"/>
    <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="18" Foreground="#C8C8C8"/>
    <TextBlock x:Name="Where" TextWrapping="Wrap" Foreground="#8F8F8F" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="SecondaryButton" MinWidth="90" Click="OnSecondary"/>
      <Button x:Name="PrimaryButton" MinWidth="90" Margin="8,0,0,0" IsDefault="True" Click="OnPrimary"/>
    </StackPanel>
  </StackPanel>
</d:DarkWindow>
