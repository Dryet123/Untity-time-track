<d:DarkWindow x:Class="UnityTimeTracker.UI.Dialogs.AddTimeDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="clr-namespace:UnityTimeTracker.UI.Dialogs"
              xmlns:c="clr-namespace:UnityTimeTracker.UI.Controls"
              Title="Add time">
  <StackPanel Margin="16" Width="380">
    <TextBlock Text="Project" Foreground="#8F8F8F" Margin="0,0,0,4"/>
    <Border Background="#2A2A2A" BorderBrush="#1F1F1F" BorderThickness="1" Height="170">
      <ListBox x:Name="Projects">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Height="22">
              <c:ProjectIcon Source="{Binding}" Width="16" Height="16" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="80"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Date (yyyy-mm-dd)" Foreground="#8F8F8F" Margin="0,0,0,4"/>
        <TextBox x:Name="DateBox"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="From" Foreground="#8F8F8F" Margin="0,0,0,4"/>
        <TextBox x:Name="FromBox" Text="10:00"/>
      </StackPanel>
      <StackPanel Grid.Column="4">
        <TextBlock Text="To" Foreground="#8F8F8F" Margin="0,0,0,4"/>
        <TextBox x:Name="ToBox" Text="11:00"/>
      </StackPanel>
    </Grid>

    <TextBlock Text="Counts as" Foreground="#8F8F8F" Margin="0,12,0,4"/>
    <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="KindUnity" Style="{StaticResource SegButton}" Content="In Unity" IsChecked="True"/>
      <RadioButton x:Name="KindIde" Style="{StaticResource SegButton}" Content="In IDE" Margin="-1,0,0,0"/>
    </StackPanel>

    <TextBlock x:Name="Message" Foreground="#E08A6A" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
      <Button x:Name="AddButton" Content="Add" IsDefault="True" MinWidth="80" Margin="8,0,0,0" Click="OnAdd"/>
    </StackPanel>
  </StackPanel>
</d:DarkWindow>
