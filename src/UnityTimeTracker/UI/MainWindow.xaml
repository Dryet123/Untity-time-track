<Window x:Class="UnityTimeTracker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:UnityTimeTracker.UI.Controls"
        Title="Unity Time Tracker" Width="1200" Height="840" MinWidth="940" MinHeight="600"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterScreen"
        Background="#232323" Foreground="#C8C8C8" FontFamily="Arial" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#232323" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
        <RadioButton x:Name="TabOverview" Style="{StaticResource TabButton}" Content="Overview" Checked="OnTab"/>
        <RadioButton x:Name="TabCalendar" Style="{StaticResource TabButton}" Content="Calendar" Checked="OnTab"/>
        <RadioButton x:Name="TabProjects" Style="{StaticResource TabButton}" Content="Projects" Checked="OnTab"/>
        <RadioButton x:Name="TabLog" Style="{StaticResource TabButton}" Content="Log" Checked="OnTab"/>
        <RadioButton x:Name="TabSettings" Style="{StaticResource TabButton}" Content="Settings" Checked="OnTab"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#2A2A2A" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="10,5">
      <DockPanel>
        <TextBlock x:Name="TodayText" DockPanel.Dock="Right" Foreground="#9A9A9A"/>
        <c:ShareBar x:Name="GoalBar" DockPanel.Dock="Right" Width="90" Height="6" Margin="0,0,10,0" Fill="#3A79BB" Visibility="Collapsed"/>
        <Rectangle x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#555555"/>
        <TextBlock x:Name="StatusText" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <ContentControl x:Name="Host" Focusable="False"/>
  </DockPanel>
</Window>
