<UserControl x:Class="UnityTimeTracker.UI.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UnityTimeTracker.UI.Controls">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="270"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <Border Background="#383838">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#3E3E3E" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="10,5" MinHeight="26">
          <TextBlock Text="Projects" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SortRecent" Style="{StaticResource SegButton}" Content="Recent" Checked="OnSort"/>
            <RadioButton x:Name="SortTime" Style="{StaticResource SegButton}" Content="Most time" Margin="-1,0,0,0" Checked="OnSort"/>
            <RadioButton x:Name="SortName" Style="{StaticResource SegButton}" Content="Name" Margin="-1,0,0,0" Checked="OnSort"/>
          </StackPanel>
          <CheckBox x:Name="ShowHidden" Content="Show hidden" Margin="0,10,0,0" Click="OnShowHidden"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="10,8">
          <Button Content="Import from Unity Hub" HorizontalAlignment="Left" Click="OnImportHub"/>
        </Border>
        <ListBox x:Name="List" SelectionChanged="OnSelect">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="40" Opacity="{Binding Opacity}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <c:ProjectIcon Source="{Binding Project}" Width="30" Height="30"/>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Foreground="#E2E2E2" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Subtitle}" Foreground="#9A9A9A" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <TextBlock x:Name="EmptyText" Grid.Column="2" Foreground="#8F8F8F" HorizontalAlignment="Center" VerticalAlignment="Center"
               TextAlignment="Center" LineHeight="20"
               Text="No projects yet.&#10;Open a project in Unity, or import the list from Unity Hub."/>

    <ScrollViewer x:Name="DetailScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Background="#383838" Padding="12" Margin="0,0,0,8">
          <DockPanel>
            <Border x:Name="IconBox" Width="80" Height="80" Background="#2E2E2E" BorderBrush="#2A2A2A" BorderThickness="1"
                    VerticalAlignment="Top" Cursor="Hand" AllowDrop="True"
                    MouseLeftButtonUp="OnIconBoxClick" DragOver="OnIconDragOver" Drop="OnIconDrop"
                    ToolTip="Click or drop an image to change the icon">
              <c:ProjectIcon x:Name="BigIcon" Margin="3"/>
            </Border>
            <StackPanel Margin="14,0,0,0">
              <TextBox x:Name="NameBox" Style="{StaticResource InlineEdit}" FontSize="20" ToolTip="Click to rename. Empty resets to the folder name."
                       KeyDown="OnNameKey" LostKeyboardFocus="OnNameLostFocus"/>
              <TextBlock x:Name="PathText" Foreground="#8F8F8F" Margin="4,4,0,0" TextTrimming="CharacterEllipsis"/>
              <WrapPanel Margin="4,10,0,0">
                <Button Content="Change icon..." Margin="0,0,6,6" Click="OnChangeIcon"/>
                <Button x:Name="ResetIconButton" Content="Reset icon" Margin="0,0,6,6" Click="OnResetIcon"/>
                <Button x:Name="OpenFolderButton" Content="Open folder" Margin="0,0,6,6" Click="OnOpenFolder"/>
                <Button x:Name="OpenUnityButton" Content="Open in Unity" Margin="0,0,6,6" Click="OnOpenUnity"/>
                <Button x:Name="HideButton" Content="Hide" Margin="0,0,6,6" Click="OnHide"
                        ToolTip="Hidden projects are left out of Overview, Calendar and Log"/>
                <Button Content="Report..." Margin="0,0,6,6" Click="OnReport" ToolTip="Printable HTML report for the selected period"/>
                <Button Content="Merge into..." Margin="0,0,6,6" Click="OnMerge" ToolTip="Move this project's time into another project"/>
                <Button Content="Delete data..." Margin="0,0,6,6" Click="OnDelete"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="4,4,0,0">
                <TextBlock Text="Color" Foreground="#8F8F8F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel x:Name="Swatches" Orientation="Horizontal"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <HeaderedContentControl Style="{StaticResource Section}" Header="About">
          <Grid x:Name="InfoGrid"/>
        </HeaderedContentControl>

        <c:StatsPanel x:Name="ProjectStats"/>

        <HeaderedContentControl x:Name="HeatSection" Style="{StaticResource Section}" Header="Activity">
          <c:YearHeatmap x:Name="Heatmap" HorizontalAlignment="Left"/>
        </HeaderedContentControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
